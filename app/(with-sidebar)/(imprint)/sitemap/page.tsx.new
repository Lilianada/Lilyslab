"use client";

import { ScrollProgress } from "@/components/ui/scroll-progress";

// Simple interface for sitemap entries
interface SitemapSection {
  title: string;
  pages: Array<{
    name: string;
    url: string;
    description?: string;
  }>;
}

// Website structure organized by sidebar sections
const sitemapData: SitemapSection[] = [
  {
    title: "Home",
    pages: [
      { name: "Hello", url: "/", description: "Welcome page" }
    ]
  },
  {
    title: "Me",
    pages: [
      { name: "About", url: "/about", description: "About me" },
      { name: "Now", url: "/now", description: "What I'm doing now" },
      { name: "Someday", url: "/someday", description: "Things I want to do someday" },
      { name: "Wants", url: "/wants", description: "Things I want" },
      { name: "Todo", url: "/todo", description: "My todo list" },
      { name: "Bucket List", url: "/bucket-list", description: "My bucket list" }
    ]
  },
  {
    title: "For You",
    pages: [
      { name: "Guestbook", url: "/guestbook", description: "Sign my guestbook" },
      { name: "Ask Me Anything", url: "/ask-me-anything", description: "Ask me a question" },
      { name: "Uses", url: "/uses", description: "Tools and apps I use" },
      { name: "Resources", url: "/resources", description: "Useful resources" }
    ]
  },
  {
    title: "Garden",
    pages: [
      { name: "Essays", url: "/writings", description: "My writings and essays" },
      { name: "Notes", url: "/notes", description: "My notes and thoughts" },
      { name: "Bookshelf", url: "/bookshelf", description: "Books I've read" }
    ]
  },
  {
    title: "Collections",
    pages: [
      { name: "Bookmarks", url: "/bookmarks", description: "Sites I've bookmarked" },
      { name: "100Pics", url: "/100pics", description: "Photo collection" },
      { name: "365days", url: "/365days", description: "Daily updates" }
    ]
  },
  {
    title: "IndieWeb",
    pages: [
      { name: "Manifesto", url: "/manifesto", description: "My IndieWeb principles" },
      { name: "Webroll", url: "/webroll", description: "People I follow" },
      { name: "Webrings", url: "/webrings", description: "Webrings I'm part of" }
    ]
  },
  {
    title: "Workshop",
    pages: [
      { name: "Projects", url: "/projects", description: "My projects" },
      { name: "Logs", url: "/logs", description: "Project logs" },
      { name: "Tools", url: "/tools", description: "Tools I've created" }
    ]
  },
  {
    title: "Playground",
    pages: [
      { name: "Digital Clock", url: "/playground/digital-clock", description: "A digital clock experiment" },
      { name: "Calculator", url: "/playground/calculator", description: "A calculator experiment" }
    ]
  },
  {
    title: "Misc",
    pages: [
      { name: "Stuff", url: "/stuff", description: "Random stuff" }
    ]
  },
  {
    title: "Imprint",
    pages: [
      { name: "Colophon", url: "/colophon", description: "About this site" },
      { name: "Changelog", url: "/changelog", description: "Recent changes" },
      { name: "Sitemap", url: "/sitemap", description: "This page" }
    ]
  }
];

export default function Sitemap() {
  return (
    <>
      <ScrollProgress
        color="bg-extra-peach"
        height={3}
        glow={true}
        glowColor="rgba(var(--extra-peach), 0.6)"
        glowIntensity="12px"
      />
      
      <div className="max-w-2xl mx-auto py-12 px-4 animate-fade-in">
        <header className="mb-8">
          <h1 className="text-2xl font-medium tracking-tight mb-3">Sitemap</h1>
          <p className="text-muted-foreground">
            A complete list of pages available on this website
          </p>
        </header>

        <div className="space-y-8">
          {sitemapData.map((section, index) => (
            <div key={index} className="pb-6 last:border-0">
              <h2 className="text-lg font-medium mb-4 border-b pb-2">{section.title}</h2>
              <ul className="space-y-2.5">
                {section.pages.map((page, pageIndex) => (
                  <li key={pageIndex}>
                    <a 
                      href={page.url}
                      className="inline-flex items-center hover:underline"
                    >
                      <span className="mr-3">⇢</span>
                      <span className="font-medium">{page.name}</span>
                    </a>
                    {page.description && (
                      <span className="text-sm text-muted-foreground ml-3">
                        — {page.description}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <footer className="mt-12 pt-4 border-t text-sm text-muted-foreground">
          <div className="flex justify-between items-center">
            <p>Last updated: June 10, 2025</p>
          </div>
        </footer>
      </div>
    </>
  );
}
