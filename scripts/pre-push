#!/bin/sh

# Run the update-timestamp.js script to update last-updated.json
node "$(git rev-parse --show-toplevel)/scripts/update-timestamp.js"

# If the script failed, prevent the push
if [ $? -ne 0 ]; then
  echo "Failed to update the last-updated.json file. Push aborted."
  exit 1
fi

# Stage the changes to last-updated.json
git add "$(git rev-parse --show-toplevel)/last-updated.json"

# Check if there are any changes to commit
if git diff --cached --quiet -- "$(git rev-parse --show-toplevel)/last-updated.json"; then
  echo "No changes to last-updated.json needed."
else
  # Commit the changes
  git commit -m "Update last-updated.json timestamp [skip ci]" -- "$(git rev-parse --show-toplevel)/last-updated.json"
  echo "Committed updated timestamp to last-updated.json"
fi

# Continue with the push
exit 0
